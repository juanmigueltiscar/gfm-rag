# vLLM LLM endpoint — used for NER and OpenIE (OpenAI-compatible API)
VLLM_BASE_URL=http://localhost:8082/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=your-llm-model-name

# Max output tokens for NER and OpenIE (adjust to fit model's context window)
VLLM_MAX_TOKENS=512
VLLM_MAX_TRIPLES_TOKENS=512

# vLLM embedding endpoint — used for entity linking (VLLMELModel)
VLLM_EMBED_BASE_URL=http://localhost:8000/v1
VLLM_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2

# HuggingFace token (required for gated models like rmanluo/G-reasoner-34M)
HF_TOKEN=hf_xx

# Use user-writable HF cache (system cache is root-owned)
HF_HOME=~/.hf_cache_user
